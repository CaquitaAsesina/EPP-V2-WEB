# =====================================================
# EPP INVENTORY - Variables de Entorno
# =====================================================
# Copiar como .env y configurar
# =====================================================

# Server
PORT=3000
NODE_ENV=development

# MySQL - Aiven
DB_HOST=tu-host.aivencloud.com
DB_PORT=tu_puerto
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=epp_inventory
DB_SSL=true

# JWT
JWT_SECRET=generar_con_openssl_rand_hex_32
JWT_EXPIRES_IN=24h

# DNI Encryption (64 hex chars)
DNI_ENCRYPTION_KEY=generar_con_openssl_rand_hex_32

# Bcrypt
BCRYPT_ROUNDS=10
