# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=epp_inventory

# JWT (generate a random string: openssl rand -hex 32)
JWT_SECRET=GENERATE_A_RANDOM_SECRET_HERE

# AES-256-GCM Encryption Key for DNI (exactly 32 bytes hex = 64 hex chars)
DNI_ENCRYPTION_KEY=GENERATE_64_HEX_CHARS_HERE

# Bcrypt
BCRYPT_ROUNDS=10
