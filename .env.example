# =====================================================
# CONFIGURACIÓN DE ENTORNO - EPP INVENTORY
# =====================================================
# Copiar este archivo como .env y configurar según el entorno
# =====================================================

# Server
PORT=3000
NODE_ENV=development

# =====================================================
# CONFIGURACIÓN LOCAL (desarrollo)
# =====================================================
# Usar cuando trabajas en tu máquina con MySQL local
# =====================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql_local
DB_NAME=epp_inventory
DB_SSL=false

# =====================================================
# CONFIGURACIÓN AIVEN (producción / Render)
# =====================================================
# Usar cuando despliegas en Render con Aiven MySQL
# Copiar estos valores desde Aiven Console → Overview
# =====================================================
# DB_HOST=mysql-xxx-yyy.aivencloud.com
# DB_PORT=12345
# DB_USER=defaultdb
# DB_PASSWORD=tu_password_aiven
# DB_NAME=epp_inventory
# DB_SSL=true

# =====================================================
# SEGURIDAD (no cambiar para desarrollo local)
# =====================================================
# Para generar valores seguros:
#   openssl rand -hex 32

# JWT Secret
JWT_SECRET=generar_con_openssl_rand_hex_32

# DNI Encryption Key (64 caracteres hex)
DNI_ENCRYPTION_KEY=generar_con_openssl_rand_hex_32

# JWT Expiration
JWT_EXPIRES_IN=24h

# Bcrypt Rounds
BCRYPT_ROUNDS=10
